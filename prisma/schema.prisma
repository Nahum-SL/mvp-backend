generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- SEGURIDAD Y USUARIOS ---

enum Role {
  ADMIN
  COLABORADOR
  CLIENTE
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // Hash de la contraseña
  name      String
  role      Role     @default(CLIENTE)
  avatar    String?
  posts     Post[] // Relación con el Blog (si es autor)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- ESTADOS (De los formularios) ---

enum ContactStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

// --- CONTACTO (Envio de formulario)

model Contacto {
  id         String        @id @default(cuid()) // <-- Cambiado a cuid()
  name       String
  email      String
  telefono   String        @db.VarChar(15) // Longitud 15 por prefijos internacionales (+51...)
  fechaNac   DateTime
  comentario String?       @db.Text // @db.Text permite textos largos
  status     ContactStatus @default(PENDING) // Estado inicial por defecto
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@map("contactos")
}

// --- SISTEMA DE BLOG ---

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  slug  String @unique
  posts Post[]
}

model Post {
  id          Int     @id @default(autoincrement())
  title       String
  slug        String  @unique
  content     String  @db.Text
  excerpt     String  @db.VarChar(255)
  image       String? // URL de la imagen (Cloudinary/S3)
  published   Boolean @default(false)
  readingTime Int     @default(5)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- SECCIÓN ÚNETE (RECURSOS HUMANOS) ---

// JobApplicationStatus 
enum JobAppStatus {
  PENDIENTE
  REVISADO
  RECHAZADO
}

model JobApplication {
  id         String       @id @default(cuid()) // <-- Cambiado a cuid()
  fullName   String
  dni        String       @unique
  age        Int
  email      String
  phone      String
  experience Int // Años
  position   String // Puesto de interés
  cvUrl      String // URL del PDF en la nube
  status     JobAppStatus @default(PENDIENTE) // PENDIENTE, REVISADO, RECHAZADO

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- SISTEMA DE INTRANET (LINKS DINÁMICOS) ---

model IntranetLink {
  id          Int     @id @default(autoincrement())
  title       String
  description String
  url         String
  icon        String? // Nombre del icono o URL
  order       Int     @default(0) // Para ordenar las cards en el dashboard
  isVisible   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- SISTEMA DE SERVICIOS ---

model Service {
  id          Int     @id @default(autoincrement())
  title       String
  slug        String  @unique
  description String  @db.Text
  icon        String? // Nombre del icono de Lucide
  image       String? // URL de la imagen almacenada en Cloudinary
  // Para el selector inteligente
  businessTypes String[] // ['mype', 'startup', 'corporativo']
  painPoints    String[] // ['impuestos', 'legal', 'planillas']

  features  ServiceFeature[]
  isVisible Boolean          @default(true)
  order     Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services")
}

model ServiceFeature {
  id        Int     @id @default(autoincrement())
  name      String
  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_features")
}
